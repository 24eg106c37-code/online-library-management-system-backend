# Local MySQL connection
DB_URL=jdbc:mysql://localhost:3306/online_library?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DDL_AUTO=update

# Replace with a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Local frontend origin. For deployment, use the exact Render Static Site origin.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional: creates the initial administrator if this email does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend build-time value (set in frontend/.env for local use)
VITE_API_BASE_URL=http://localhost:8080/api
